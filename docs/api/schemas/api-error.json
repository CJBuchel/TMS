{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApiErrorBody",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "details": {
      "description": "Individual problems, for errors that have several (such as a schedule file with bad lines).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "message"
  ]
}
